<%
    var respInst = "you will use the 'E' and 'I' computer keys to";
    if (global.$isTouch)  respInst = "you will";
%>

<style>
	.task-instructions-table img {
		margin: 2px;
	}

	@media (max-width: 600px) {
		.task-instructions-table {
			font-size: 1.05em !important;
			border: 0;
		}

		.task-instructions-table tr:first-child {
			display: none;
		}

		.task-instructions-table,
		.task-instructions-table tbody,
		.task-instructions-table tr,
		.task-instructions-table th,
		.task-instructions-table td {
			display: block;
			width: 100%;
		}

		.task-instructions-table tr {
			margin-bottom: 12px;
			border: 1px solid #ddd;
		}

		.task-instructions-table th,
		.task-instructions-table td {
			border: 0 !important;
		}

		.task-instructions-table th {
			background: #f5f5f5;
		}

		.task-instructions-image-grid {
			display: grid !important;
			grid-template-columns: repeat(3, minmax(0, 60px));
			gap: 6px;
			justify-content: start;
		}

		.task-instructions-image-grid img {
			width: 60px;
			height: 60px;
			margin: 0;
			object-fit: cover;
		}
	}
</style>
<div class="panel panel-info" style="margin-top:1em">
		<div class="panel-heading">
			<h1 class="panel-title" style="font-size:2em">
				Task Instructions
			</h1>
		</div>
</div>

<div class="panel-body">
	<div class="alert alert-warning" role="note" style="margin-bottom: 24px; font-size: 1.15em; line-height: 1.5;">
		<strong>Please complete this task in one sitting.</strong> The task will take approximately 5 minutes.
	</div>
	<p class="lead">Next, <%=respInst%> categorize items into groups as fast as you can. 
	These are the four groups and the items that belong to each:</p>

	<table class="table table-bordered task-instructions-table" style="font-size: 1.18em; line-height: 1.45;">
		<tr class="active">
			<th>Category</th>
			<th>Items</th>
		</tr>
		<tr>
			<th>Good Student</th>
			<td><%=global.posWords[0]%>, <%=global.posWords[1]%>, <%=global.posWords[2]%>, 
			<%=global.posWords[3]%>, <%=global.posWords[4]%>, <%=global.posWords[5]%></td>
		</tr>
		<tr>
			<th>Bad Student</th>
			<td><%=global.negWords[0]%>, <%=global.negWords[1]%>, <%=global.negWords[2]%>, 
			<%=global.negWords[3]%>, <%=global.negWords[4]%>, <%=global.negWords[5]%></td>
		</tr>
		<tr>
			<th><%=global.asianLabels%></th>
	<td class="task-instructions-image-grid">
		  <img src="<%=global.baseURL%>FAS04.jpg" height=60>
		  <img src="<%=global.baseURL%>FAS05.jpg" height=60>
		  <img src="<%=global.baseURL%>FAS07.jpg" height=60>
		  <img src="<%=global.baseURL%>MAS01.jpg" height=60>
		  <img src="<%=global.baseURL%>MAS03.jpg" height=60>
		  <img src="<%=global.baseURL%>MAS06.jpg" height=60>

	   
			  </td>
		</tr>
		<tr>
			<th><%=global.whiteLabels%></th>
			<td class="task-instructions-image-grid">
			  <img src="<%=global.baseURL%>FEA15.jpg" height=60>
			  <img src="<%=global.baseURL%>FEA23.jpg" height=60>
			  <img src="<%=global.baseURL%>FEA36.jpg" height=60>
			  <img src="<%=global.baseURL%>MEA06b.jpg" height=60>
			  <img src="<%=global.baseURL%>MEA11.jpg" height=60>
			  <img src="<%=global.baseURL%>MEA14.jpg" height=60>

			
			  </td>
		</tr>
	</table>

	<p class="lead">There are seven parts.  The instructions change for each part.  Pay attention!<p>

	<div class="text-center proceed" style="margin: 30px auto 10px;">
		<button pi-message-done type="button" class="btn btn-primary btn-lg" onclick="return window.prepareIatOrientation ? window.prepareIatOrientation(event, this) : true;">
			Start
		</button>
	</div>
</div>

